{
  "name": "shopta",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "TSX_TSCONFIG=shopping-taxi-app/tsconfig.json node --import tsx --test",
    "lint": "eslint -c shopping-taxi-app/.eslintrc.cjs \"shopping-taxi-app/**/*.{ts,tsx,js,jsx}\"",
    "format": "prettier --write .",
    "start": "TSX_TSCONFIG=shopping-taxi-app/tsconfig.json tsx shopping-taxi-app/src/app/backend/server_apis_db/server.ts",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/migrations/001_schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seeds/001_seed.sql",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.5",
    "axios": "^1.6.7",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^8.5.1",
    "leaflet": "^1.9.4",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "next": "^16.1.6",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/leaflet": "^1.9.12",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
