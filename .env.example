# Shopta local development environment
# Copy this file to .env and replace placeholder secrets/keys before running services.

# PostgreSQL
POSTGRES_USER=shopta
POSTGRES_PASSWORD=shopta_password
POSTGRES_DB=shopta
DATABASE_URL=postgresql://shopta:shopta_password@postgres:5432/shopta

# Backend/API server
PORT=5001
BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-token-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
PYTHON_OPTIMIZER_URL=http://route-optimizer:8000
ANALYTICS_SERVICE_URL=http://trip-analytics:8085

# Google Maps / Places API
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-google-maps-browser-api-key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001
